# Copy to .env.local for local dev, and set the same in Vercel → Project → Settings → Environment Variables.

# Secret used to sign session cookies. Use a long random string in production.
# Generate one with: openssl rand -base64 32
TWINE_SECRET=change-me-to-a-long-random-string

# Public base URL of the app (used to build payment redirect URLs).
APP_URL=https://loopline-4.vercel.app

# ------------------------------------------------------------------
# Payments — Stripe (https://dashboard.stripe.com/apikeys)
# Each business chooses Stripe or Square in Settings; the app uses the
# matching credentials below. Leave blank to run in mock mode.
# ------------------------------------------------------------------
STRIPE_SECRET_KEY=

# ------------------------------------------------------------------
# Payments — Square (https://developer.squareup.com/apps)
# SQUARE_ENV: "sandbox" (default) or "production".
# ------------------------------------------------------------------
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENV=sandbox

# ------------------------------------------------------------------
# QuickBooks Online (https://developer.intuit.com)
# Get access/refresh tokens + realm (company) id from the Intuit
# OAuth 2.0 Playground. QBO_ENV: "sandbox" (default) or "production".
# ------------------------------------------------------------------
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_ACCESS_TOKEN=
QBO_REFRESH_TOKEN=
QBO_REALM_ID=
QBO_ENV=sandbox

# QuickBooks Payroll is partner-gated. Set to "true" once your Intuit app
# has payroll scopes approved to enable payroll features in Twine.
QBO_PAYROLL_ENABLED=false
